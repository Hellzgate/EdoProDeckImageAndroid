<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>WindBotDeckImageAndroid</RootNamespace>
    <AssemblyName>WindBotDeckImageAndroid</AssemblyName>
    <ApplicationId>com.hellzgate.windbotdeckimage</ApplicationId>
    <ApplicationTitle>덱 이미지</ApplicationTitle>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>1.7</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableLLVM>false</EnableLLVM>
    <Version>1.7</Version>
    <FileVersion>1.7.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- PC 버전과 같은 렌더러 (SkiaSharp, WinForms 비의존) -->
    <Compile Include="..\_shared\DeckImageSkia\DeckImageSkiaRenderer.cs" Link="DeckImageSkiaRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.txt" Condition="Exists('README.txt')" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
